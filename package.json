{
  "name": "@homestar9/nocturne-ui",
  "version": "1.5.0",
  "description": "Nocturne — a dark-first SaaS design system. CSS tokens, BEM component classes, and a bundled Claude Code skill.",
  "license": "MIT",
  "author": "David Levin",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/nocturne.css",
  "style": "./dist/nocturne.css",
  "exports": {
    ".": "./dist/nocturne.css",
    "./css": "./dist/nocturne.css",
    "./tokens": "./dist/tokens.css",
    "./js": "./js/nocturne.js",
    "./themes/*": "./themes/*",
    "./src/*": "./src/*",
    "./skill": "./skill/SKILL.md",
    "./skill/*": "./skill/*",
    "./build": "./scripts/build.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "nocturne-build": "scripts/build.mjs"
  },
  "files": [
    "dist",
    "src",
    "js",
    "themes",
    "skill",
    "scripts/build.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs && node scripts/test-dom.mjs",
    "prepack": "node scripts/build.mjs && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homestar9/nocturne-ui.git"
  },
  "homepage": "https://github.com/homestar9/nocturne-ui#readme",
  "bugs": {
    "url": "https://github.com/homestar9/nocturne-ui/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "dark-ui",
    "bem",
    "claude-code"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
